{
  "name": "mage-puzzle-dungeon",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive 3D dungeon map for a D&D campaign: place, rotate and move rooms from a fixed catalogue.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0"
  }
}
